<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Dynamic Efficiency-Thoroughness Decision-Making
;;
;; Agents choose between:
;; 1. Safe/compliant behavior
;; 2. Efficient/non-compliant behavior
;;
;; Organizational interventions:
;; 1. Baseline (none); BL
;; 2. Reduce perceived effort of safe behavior; RES
;; 3. Increase perceived effort of efficient behavior; IEE
;; 4. Increase perceived accident consequences; IRC
;; 6. Clarify risk probability temporary; CRP-T
;; 6. Clarify risk probability fixed; CRP-F
;; 7. Increase information availability; IIA
;; 5. Reduce actual risk probability; RAP
;; 5. Reduce actual risk consequences; RAC
;;
;; Decision:
;; Expected perceived disutility minimization
;;
;; Learning:
;; Agents update perceived accident probability
;; based on direct and socially observed accident experiences.
;;
;; Network:
;; Agents exchange information through a social network.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

extensions [nw]

globals [
  accidents
  accident-rate
  total-decisions
  total-decisions-tick
  p-safe-storage-tick
  mean-p-safe-tick
  mean-p-safe-tick-1

  objective-safe-effort
  objective-efficient-effort
  objective-safe-risk-consequence 
  objective-efficient-risk-consequence
  objective-safe-risk-probability
  objective-efficient-risk-probability
  
  prod-reward-per-piece
  model-pos-incentive-safe
  model-neg-incentive-efficient
  model-accident-punishment
  model-actual-risk-probability-reduction
  model-actual-risk-consequence-reduction
  model-risk-clarification-fixed-safe-accident-evidence
  model-risk-clarification-fixed-safe-total-evidence
  model-risk-clarification-fixed-efficient-accident-evidence
  model-risk-clarification-fixed-efficient-total-evidence
  
  memory-retention
  
  weekday
  work
  
]

turtles-own [
  ;; Network and time variables
  amount-of-links    ; How many links
  observable-workers ; What other workers it can ultimately see
  daily-cycles       ; How many decisions
  
  ;; Perception of objective values
  perceived-safe-effort
  perceived-efficient-effort
  perceived-safe-risk-probability
  perceived-efficient-risk-probability
  perceived-safe-risk-consequence
  perceived-efficient-risk-consequence
  
  ;; Experience about accident occurence
  new-accident-evidence-safe
  new-accident-evidence-efficient
  new-non-accident-evidence-safe
  new-non-accident-evidence-efficient
  
  accumulated-accident-evidence-safe
  accumulated-accident-evidence-efficient
  accumulated-non-accident-evidence-safe
  accumulated-non-accident-evidence-efficient
  
  ;; Stored information for subsequent analysis
  past-behavior
  past-round-accident
  p-safe
  individual-accident-count
  individual-mean-p-safe-tick
  individual-p-safe-storage-tick
  individual-total-decisions-tick
]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; SETUP
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to setup
  
  clear-all
  
  ;; Define seed for comparibility
  random-seed simulation-seed
  
  ;; Reset globals
  set accidents 0
  set accident-rate 0
  set total-decisions 0
  
  ;; Objective environment values
  set objective-safe-effort baseline-efficient-effort + add-delta-safe-effort
  set objective-efficient-effort baseline-efficient-effort
  set objective-safe-risk-probability baseline-safe-risk-probability
  set objective-efficient-risk-probability baseline-safe-risk-probability + add-delta-efficient-risk-probability
  set objective-efficient-risk-consequence round ( overall-efficient-risk / objective-efficient-risk-probability )
  set objective-safe-risk-consequence  objective-efficient-risk-consequence
  
  ifelse half-life > 0 [set memory-retention 2 ^ ( (-1 / half-life) )] [set memory-retention 0]
  set mean-p-safe-tick-1 0
  
  set weekday 0
  set work true
  
  prep-interventions
  
  ;; Create a specified number of workers
  create-turtles number-of-workers [
    
    ;; Perception of objective values
    set perceived-safe-effort objective-safe-effort
    set perceived-efficient-effort objective-efficient-effort
    set perceived-safe-risk-consequence objective-safe-risk-consequence 
    set perceived-efficient-risk-consequence objective-efficient-risk-consequence
    set perceived-safe-risk-probability perceived-safe-risk-probability-t0
    set perceived-efficient-risk-probability perceived-efficient-risk-probability-t0
    
    ;; No decisions yet
    set past-behavior "none"
    set past-round-accident "no"
    set p-safe 0
    set individual-accident-count 0
    
    ;; No experience yet
    set new-accident-evidence-safe 0
    set new-accident-evidence-efficient 0
    set new-non-accident-evidence-safe 0
    set new-non-accident-evidence-efficient 0
    
    set accumulated-accident-evidence-safe 0
    set accumulated-accident-evidence-efficient 0
    set accumulated-non-accident-evidence-safe 0
    set accumulated-non-accident-evidence-efficient 0
    
    ;; Visuals
    set shape "circle"
    setxy random-xcor random-ycor
    recolor-agent
    
    ;; Prepartaion for network construction
    set amount-of-links 0
  ]
  
  ;; Visuals
  ask patches [
    set pcolor white
  ]
  
  ;; Network construction
  create-network
  
  ;; Set observation radius
  ask turtles [
    set observable-workers link-neighbors
    set observable-workers (turtle-set observable-workers self)
  ]
  
  reset-ticks
  
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Assign intervention weights
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; 

to prep-interventions
  
  set model-pos-incentive-safe intervention-weight
  set model-neg-incentive-efficient intervention-weight
  set model-accident-punishment intervention-weight
  set model-actual-risk-probability-reduction intervention-weight
  set model-actual-risk-consequence-reduction intervention-weight
  
  set model-risk-clarification-fixed-safe-accident-evidence 0
  set model-risk-clarification-fixed-safe-total-evidence 0
  set model-risk-clarification-fixed-efficient-accident-evidence 0
  set model-risk-clarification-fixed-efficient-total-evidence 0
  
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Network (create-network)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; 

to create-network
  
;; STEP 1: Create one link for every turtle
  if average_links > 0 [
    let network (turtle-set one-of turtles)
  
    while [count network < number-of-workers] [
      let new-turtle one-of turtles with [
        not member? self network
      ]
    
      let existing-turtle one-of network
    
      ask new-turtle [
        create-link-with existing-turtle
      ]
    
      set network (turtle-set network new-turtle)
    ]

  ;; Step 2: Add more links until saturated
    let target-links round ((average_links * number-of-workers) / 2)
  
    while [count links < target-links] [
      ask one-of turtles [
        let partner one-of other turtles with [
          not link-neighbor? myself
        ]
    
        if partner != nobody [
          create-link-with partner
        ]
      ]
    ]
  ]
  
;; Step 3: Check whether it worked
  ; This allows to check whether process has been done right
  ask turtles [
    set amount-of-links count my-links
    set label amount-of-links
    set label-color black
  ]
  
  ; This allows to better visualize network
  repeat 1000 [
    layout-spring turtles links 1 3 10
  ]
  
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; GO
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;   
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to go
  
  set total-decisions-tick 0
  set mean-p-safe-tick 0
  ask turtles [ set individual-p-safe-storage-tick 0 ]
  set p-safe-storage-tick 0
  
  ifelse weekday < 7 [ set weekday weekday + 1 ] [ set weekday 1 ]
  
  burn-in
  
  ifelse (weekday = 6 or weekday = 7) [
    set work false
    ask turtles [ 
    set daily-cycles 0
    set individual-total-decisions-tick daily-cycles
]]
  [set work true
    ask turtles [ 
    set daily-cycles max list 1 (round (random-normal mean-d-cycles sd-d-cycles))
    set individual-total-decisions-tick daily-cycles
  ]]
  
  repeat max [daily-cycles] of turtles [
    
    ask turtles with [daily-cycles > 0] [
      
      decision-making
      
      perform-task
      
      update-risk
      
      set daily-cycles daily-cycles - 1
      set total-decisions total-decisions + 1
      set total-decisions-tick total-decisions-tick + 1
    ]
    
  ]
  
  tick
  
  ask turtles [
    discount-memory
  ]
  
  calc-mean-p-safe
  
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Organizational Intervention Burn In (burn-in)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to burn-in
  if ticks = burn-in-rounds [
    with-local-randomness [
    
      if organizational-intervention = "reduce-objective-risk-probability" [
        set objective-efficient-risk-probability objective-efficient-risk-probability - objective-efficient-risk-probability * model-actual-risk-probability-reduction
      ]
    
      ask turtles [
    
      if organizational-intervention = "reduce-perceived-effort-safe" [
        set perceived-safe-effort perceived-safe-effort - add-delta-safe-effort * model-pos-incentive-safe
      ]
    
      if organizational-intervention = "increase-perceived-effort-efficient" [
        set perceived-efficient-effort perceived-efficient-effort + add-delta-safe-effort  * model-neg-incentive-efficient
      ]
    
      if organizational-intervention = "increase-perceived-risk-consequence" [
        set perceived-efficient-risk-consequence perceived-efficient-risk-consequence + perceived-efficient-risk-consequence * model-accident-punishment
      ]
      
      if organizational-intervention = "reduce-objective-risk-consequence" [
        set perceived-efficient-risk-consequence perceived-efficient-risk-consequence - perceived-efficient-risk-consequence * model-actual-risk-consequence-reduction
      ]
    
      if organizational-intervention = "clarify-risk-probability-temporary" [
          if objective-efficient-risk-probability > 0 [
            set accumulated-accident-evidence-efficient
              accumulated-non-accident-evidence-efficient * objective-efficient-risk-probability ]
          if objective-safe-risk-probability > 0 [
            set accumulated-accident-evidence-safe
              accumulated-non-accident-evidence-safe * objective-safe-risk-probability ]
      ]
        
      if organizational-intervention = "clarify-risk-probability-fixed" [
          let total-evidence-efficient accumulated-accident-evidence-efficient + accumulated-non-accident-evidence-efficient
          if objective-efficient-risk-probability > 0 [
            set model-risk-clarification-fixed-efficient-accident-evidence
              total-evidence-efficient * objective-efficient-risk-probability
            set model-risk-clarification-fixed-efficient-total-evidence total-evidence-efficient ]
          
          let total-evidence-safe accumulated-accident-evidence-safe + accumulated-non-accident-evidence-safe
          if objective-safe-risk-probability > 0 [
            set model-risk-clarification-fixed-safe-accident-evidence
              total-evidence-safe * objective-safe-risk-probability
            set model-risk-clarification-fixed-safe-total-evidence total-evidence-safe]
      ]
      
      if organizational-intervention = "increase-information-availability" [
        set observable-workers 
            (turtle-set observable-workers [link-neighbors] of observable-workers)
        ]
      ]
    ]
  ]

end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Dynamic Efficiency-Thoroughness Decision-Making (decision-making)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to decision-making

  ;; Calculate Disutility-Value SAFE
  let D-safe
    (perceived-safe-effort)
    +
    (perceived-safe-risk-probability *
     perceived-safe-risk-consequence)


  ;; Calculate Disutility-Value EFFICIENT
  let D-efficient
    (perceived-efficient-effort)
    +
    (perceived-efficient-risk-probability *
     perceived-efficient-risk-consequence)


  
  set p-safe (exp (- D-safe)) /
          ((exp (- D-safe)) + (exp (- D-efficient)))
  
  set individual-p-safe-storage-tick individual-p-safe-storage-tick + p-safe
  
  ifelse random-float 1 < p-safe
  [
    set past-behavior "safe"
  ]
  [
    set past-behavior "efficient"
  ]

  recolor-agent
  
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Task Execution (perform-task)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to perform-task

  ;; safe behavior choice
  if past-behavior = "safe"
  [

    ifelse random-float 1 < objective-safe-risk-probability
    [
      set accidents accidents + 1
      set past-round-accident "yes"
      set individual-accident-count individual-accident-count + 1
    ][
      set past-round-accident "no"
    ]

  ]

  ;; efficient behavior choice
  if past-behavior = "efficient"
  [

    ifelse random-float 1 < objective-efficient-risk-probability
    [
      set accidents accidents + 1
      set past-round-accident "yes"
      set individual-accident-count individual-accident-count + 1
    ][
      set past-round-accident "no"
    ]

  ]
  
  set label individual-accident-count
  set label-color black
  
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Adaptive Risk Learning (update-risk)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to update-risk
  
  with-local-randomness [
    ifelse past-behavior = "safe"
  
    ;; safe updating
    [ ifelse past-round-accident = "yes" 
      [ ask observable-workers [ set new-accident-evidence-safe new-accident-evidence-safe + 1 ]]
      [ ask observable-workers [ set new-non-accident-evidence-safe new-non-accident-evidence-safe + 1 ]]
    
      ask observable-workers
      [ let total-evidence-safe accumulated-accident-evidence-safe + accumulated-non-accident-evidence-safe
        let new-safe-risk
        (prior-weight * accumulated-accident-evidence-safe + new-accident-evidence-safe + model-risk-clarification-fixed-safe-accident-evidence) /
        (prior-weight * total-evidence-safe +  new-accident-evidence-safe + new-non-accident-evidence-safe + model-risk-clarification-fixed-safe-total-evidence)
      
        set perceived-safe-risk-probability max list 0 (min list 1 new-safe-risk) ]
    ]
  
    ;; efficient updating
    [ ifelse past-round-accident = "yes" 
      [ ask observable-workers [ set new-accident-evidence-efficient new-accident-evidence-efficient + 1 ]]
      [ ask observable-workers [ set new-non-accident-evidence-efficient new-non-accident-evidence-efficient + 1 ]]
    
      ask observable-workers
      [ let total-evidence-efficient accumulated-accident-evidence-efficient + accumulated-non-accident-evidence-efficient
        let new-efficient-risk
        (prior-weight * accumulated-accident-evidence-efficient + new-accident-evidence-efficient + model-risk-clarification-fixed-efficient-accident-evidence * CRP-weight) /
        (prior-weight * total-evidence-efficient + new-accident-evidence-efficient + new-non-accident-evidence-efficient + model-risk-clarification-fixed-efficient-total-evidence * CRP-weight)
      
        set perceived-efficient-risk-probability max list 0 (min list 1 new-efficient-risk) ]
    ]
  ]

end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Memory Discounting (discount-memory)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;  

to discount-memory

  set accumulated-accident-evidence-safe
    memory-retention * (accumulated-accident-evidence-safe + new-accident-evidence-safe)
  set new-accident-evidence-safe 0

  set accumulated-non-accident-evidence-safe
    memory-retention * (accumulated-non-accident-evidence-safe + new-non-accident-evidence-safe)
  set new-non-accident-evidence-safe 0

  set accumulated-accident-evidence-efficient
    memory-retention * (accumulated-accident-evidence-efficient + new-accident-evidence-efficient)
  set new-accident-evidence-efficient 0

  set accumulated-non-accident-evidence-efficient
    memory-retention * (accumulated-non-accident-evidence-efficient + new-non-accident-evidence-efficient)
  set new-non-accident-evidence-efficient 0

end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; run (60x GO)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;  

to simulate
  
  repeat 63 [ go ]
  
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Visualize (recolor-agent)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to recolor-agent

  if past-behavior = "safe"
  [
    set color green
  ]

  if past-behavior = "efficient"
  [
    set color red
  ]
  
  if past-behavior = "none"
  [
    set color grey
  ]

end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Calculate mean p-safe per tick (calc-mean-p-safe)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;  

to calc-mean-p-safe
  
  ifelse (work = false) [
    ask turtles [ set individual-mean-p-safe-tick 0 ]
    set mean-p-safe-tick mean-p-safe-tick-1 ]
  [
  ;; individual tick
  ask turtles [ set individual-mean-p-safe-tick individual-p-safe-storage-tick / individual-total-decisions-tick ]

  ;; global tick
  set p-safe-storage-tick sum [individual-p-safe-storage-tick] of turtles
  set mean-p-safe-tick p-safe-storage-tick / total-decisions-tick
  set mean-p-safe-tick-1 mean-p-safe-tick
  ]
  ;; Plot global mean p-safe
  set-current-plot "Mean P-Safe"
  set-current-plot-pen "default"
ifelse work [
  set-plot-pen-color green
  plot mean-p-safe-tick
][
  set-plot-pen-color violet
  plot mean-p-safe-tick
]

end

  
  
  
  ]]></code>
  <widgets>
    <view x="315" wrappingAllowedX="false" y="20" frameRate="30.0" minPycor="-15" height="405" showTickCounter="true" patchSize="12.94" fontSize="10" wrappingAllowedY="false" width="405" tickCounterLabel="ticks" maxPycor="15" updateMode="0" maxPxcor="15" minPxcor="-15"></view>
    <monitor x="40" precision="17" y="365" height="60" fontSize="11" width="250" display="mean-length-paths">nw:mean-path-length</monitor>
    <note x="40" y="15" backgroundDark="0" fontSize="14" width="250" markdown="false" height="30" textColorDark="-1" textColorLight="-1" backgroundLight="-8630108">Network Selection</note>
    <slider x="40" step="1" y="50" max="50" width="250" display="number-of-workers" height="50" min="0" direction="Horizontal" default="30.0" variable="number-of-workers"></slider>
    <slider x="40" step="1" y="105" max="10" width="250" display="average_links" height="50" min="0" direction="Horizontal" default="4.0" variable="average_links"></slider>
    <monitor x="40" precision="17" y="300" height="60" fontSize="11" width="250" display="mean-links-per-turtle">mean [count my-links] of turtles</monitor>
    <plot x="40" autoPlotX="true" yMax="10.0" autoPlotY="true" y="160" xMin="0.0" height="135" legend="false" xMax="20.0" yMin="0.0" width="250" display="Histogram worker links">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="1" display="default" color="-11053225" legend="true">
        <setup></setup>
        <update>histogram [amount-of-links] of turtles</update>
      </pen>
    </plot>
    <chooser x="40" y="500" height="60" variable="baseline-efficient-effort" current="5" width="200" display="baseline-efficient-effort">
      <choice type="double" value="0.0"></choice>
      <choice type="double" value="1.0"></choice>
      <choice type="double" value="2.0"></choice>
      <choice type="double" value="3.0"></choice>
      <choice type="double" value="4.0"></choice>
      <choice type="double" value="5.0"></choice>
      <choice type="double" value="6.0"></choice>
      <choice type="double" value="7.0"></choice>
      <choice type="double" value="8.0"></choice>
      <choice type="double" value="9.0"></choice>
      <choice type="double" value="10.0"></choice>
      <choice type="double" value="100.0"></choice>
    </chooser>
    <chooser x="40" y="565" height="60" variable="baseline-safe-risk-probability" current="0" width="200" display="baseline-safe-risk-probability">
      <choice type="double" value="0.0"></choice>
    </chooser>
    <chooser x="270" y="500" height="60" variable="add-delta-safe-effort" current="5" width="185" display="add-delta-safe-effort">
      <choice type="double" value="0.0"></choice>
      <choice type="double" value="2.0"></choice>
      <choice type="double" value="4.0"></choice>
      <choice type="double" value="6.0"></choice>
      <choice type="double" value="8.0"></choice>
      <choice type="double" value="10.0"></choice>
      <choice type="double" value="12.0"></choice>
      <choice type="double" value="14.0"></choice>
      <choice type="double" value="16.0"></choice>
      <choice type="double" value="18.0"></choice>
      <choice type="double" value="20.0"></choice>
    </chooser>
    <chooser x="270" y="565" height="60" variable="add-delta-efficient-risk-probability" current="2" width="185" display="add-delta-efficient-risk-probability">
      <choice type="double" value="0.01"></choice>
      <choice type="double" value="0.001"></choice>
      <choice type="double" value="1.0E-4"></choice>
      <choice type="double" value="1.0E-5"></choice>
    </chooser>
    <note x="240" y="575" backgroundDark="0" fontSize="18" width="30" markdown="false" height="35" textColorDark="-1" textColorLight="-16777216" backgroundLight="-1">+</note>
    <note x="240" y="510" backgroundDark="0" fontSize="18" width="30" markdown="false" height="35" textColorDark="-1" textColorLight="-16777216" backgroundLight="-1">+</note>
    <note x="455" y="510" backgroundDark="0" fontSize="18" width="30" markdown="false" height="35" textColorDark="-1" textColorLight="-16777216" backgroundLight="-1">=</note>
    <note x="455" y="575" backgroundDark="0" fontSize="18" width="30" markdown="false" height="35" textColorDark="-1" textColorLight="-16777216" backgroundLight="-1">=</note>
    <monitor x="605" precision="17" y="500" height="60" fontSize="11" width="115" display="obj-effort-efficient">baseline-efficient-effort</monitor>
    <monitor x="485" precision="17" y="500" height="60" fontSize="11" width="115" display="obj-effort-safe">baseline-efficient-effort + add-delta-safe-effort</monitor>
    <monitor x="485" precision="17" y="565" height="60" units="%" fontSize="11" width="115" display="obj-risk-safe">baseline-safe-risk-probability * 100</monitor>
    <monitor x="605" precision="17" y="565" height="60" units="%" fontSize="11" width="115" display="obj-eff-risk-probability">(baseline-safe-risk-probability + add-delta-efficient-risk-probability) * 100</monitor>
    <monitor x="605" precision="0" y="630" height="60" fontSize="11" width="115" display="obj-eff-risk-consequence">objective-efficient-risk-consequence</monitor>
    <monitor x="485" precision="0" y="630" height="60" fontSize="11" width="115" display="obj-safe-risk-consequence">objective-safe-risk-consequence</monitor>
    <monitor x="605" precision="17" y="695" height="60" fontSize="11" width="115" display="D-efficient">baseline-efficient-effort + (baseline-safe-risk-probability + add-delta-efficient-risk-probability) * objective-efficient-risk-consequence</monitor>
    <monitor x="485" precision="17" y="695" height="60" fontSize="11" width="115" display="D-safe">baseline-efficient-effort + add-delta-safe-effort + baseline-safe-risk-probability * objective-safe-risk-consequence</monitor>
    <note x="40" y="465" backgroundDark="0" fontSize="14" width="680" markdown="false" height="30" textColorDark="-1" textColorLight="-1" backgroundLight="-13345367">Environment Baseline Selection</note>
    <slider x="270" step="0.01" y="695" max="1" width="185" display="perceived-efficient-risk-probability-t0" height="60" min="0" direction="Horizontal" default="0.0" variable="perceived-efficient-risk-probability-t0"></slider>
    <note x="40" y="660" backgroundDark="0" fontSize="14" width="415" markdown="false" height="30" textColorDark="-1" textColorLight="-1" backgroundLight="-8630108">Initial beliefs about Risk Probability</note>
    <slider x="40" step="0.01" y="695" max="1" width="200" display="perceived-safe-risk-probability-t0" height="60" min="0" direction="Horizontal" default="0.0" variable="perceived-safe-risk-probability-t0"></slider>
