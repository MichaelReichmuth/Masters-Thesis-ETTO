    <experiment name="Final" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="true" timeLimit="63">
      <setup>setup</setup>
      <go>go</go>
      <runMetricsCondition>ticks = 60</runMetricsCondition>
      <metrics>
        <metric>accidents</metric>
        <metric>mean-p-safe-tick</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="organizational-intervention">
          <value value="&quot;baseline&quot;"></value>
          <value value="&quot;reduce-perceived-effort-safe&quot;"></value>
          <value value="&quot;increase-perceived-effort-efficient&quot;"></value>
