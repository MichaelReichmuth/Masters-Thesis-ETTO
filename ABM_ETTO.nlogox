          <value value="&quot;reduce-objective-risk-probability&quot;"></value>
          <value value="&quot;reduce-objective-risk-consequence&quot;"></value>
          <value value="&quot;clarify-risk-probability-temporary&quot;"></value>
          <value value="&quot;clarify-risk-probability-fixed&quot;"></value>
          <value value="&quot;increase-information-availability&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="organizational-incentive">
          <value value="&quot;neutral&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="perceived-safe-risk-probability-t0">
          <value value="0"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="perceived-efficient-risk-probability-t0">
          <value value="0"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="overall-efficient-risk">
